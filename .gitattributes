* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.gz binary
*.docx binary
*.pdf binary
*.cif binary
# Frozen source tables: preserve bytes and trailing empty TSV fields.
axis/resources/evidence-integration/erap1-data-rich/2026/v1/inputs/*.txt -text whitespace=-blank-at-eol
axis/resources/evidence-integration/erap1-data-rich/2026/v1/inputs/*.tsv -text whitespace=-blank-at-eol
# Immutable audit corpora must retain Git bytes, including checksum files.
axis/resources/** -text
reports/commercial/erap1-axspa/v1/** -text
benchmarks/** -text
